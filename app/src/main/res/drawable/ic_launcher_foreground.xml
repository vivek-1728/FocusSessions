<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark track ring (full circle) -->
    <path
        android:pathData="M 54,24 A 30,30 0 1,1 53.99,24"
        android:strokeWidth="7.5"
        android:strokeColor="#25233A"
        android:strokeLineCap="round"/>

    <!-- Colorful Active Arc (12:00 clockwise to 9:00) -->
    <path
        android:pathData="M 54,24 A 30,30 0 1,1 24,54"
        android:strokeWidth="7.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="24"
                android:endX="24"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.00" android:color="#FF26B0FF"/>
                <item android:offset="0.35" android:color="#FF4B88FF"/>
                <item android:offset="0.70" android:color="#FF9163FF"/>
                <item android:offset="1.00" android:color="#FF35A5FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- White dot indicator at 9 o'clock -->
    <path
        android:pathData="M 24,54 m -4.5,0 a 4.5,4.5 0 1,0 9,0 a 4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFFFFF"/>

    <!-- Hour hand (pointing straight UP to 12:00) -->
    <path
        android:pathData="M 54,54 L 54,36"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"/>

    <!-- Minute hand (pointing down-right to ~4:00) -->
    <path
        android:pathData="M 54,54 L 71.2,66"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"/>

    <!-- Center pivot point -->
    <path
        android:pathData="M 54,54 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0"
        android:fillColor="#FFFFFF"/>
</vector>
